rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sellers/{uid} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if (request.auth != null && resource.data.sellerId == request.auth.uid) || 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'shares', 'whatsappShares', 'facebookShares', 'linkCopies']));
      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }
    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }
  }
}
